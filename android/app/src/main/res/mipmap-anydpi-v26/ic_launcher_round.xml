<?xml version="1.0" encoding="utf-8"?>
<!-- V-15: три слоя вместо двух. Фон стал растровым (ночь с виньеткой) вместо
     плоского @color — плоская заливка делала иконку дешёвой. Слой monochrome
     нужен темизованным иконкам Android 13+; без него система рисует в теме
     обрезанный foreground со свечением, то есть грязное пятно.
     Все три собирает dev/docs/tools/gen-app-icon.js с флагом android. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
