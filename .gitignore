# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Editor files
*.swp
*.swo
*~
.cursor/

# --- P-02: нативная сборка (только ветка capacitor) ---------------------------
# Репозиторий ПУБЛИЧНЫЙ. Игнор заведён до первого `cap add android`, а не после,
# чтобы сгенерированное дерево не попало в индекс случайно.
node_modules/
www/

# Android-проект: в репозитории живут только исходники, всё сгенерированное — нет
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
# local.properties содержит абсолютный путь к SDK этой машины
android/local.properties

# ⚠️ Ключи подписи в публичный репозиторий не попадают ни при каких условиях
*.keystore
*.jks
keystore.properties

# --- A-07: музыка ------------------------------------------------------------
# В репозитории живут только пережатые в 96 kbps треки (`music/*.mp3`).
# Мастера 320 kbps — исходники пережатия, 25 МБ на двоих: в публичном репозитории
# им делать нечего, а без них игра собирается. Скачиваются заново по адресам
# из `music/CREDITS.md`.
music/masters/

# --- P-05: аналитика ---------------------------------------------------------
# Адрес приёма и ключ проекта PostHog для сборки APK. Ключ `phc_…` по замыслу
# публичный (только запись событий, чтения данных им нет) и извлекается из
# любого APK — но репозиторий публичный, и заносить его сюда незачем.
# Формат: {"host": "https://eu.i.posthog.com", "key": "phc_…"}
# Нет файла — сборка идёт, аналитика выключена, build-www.js говорит об этом вслух.
analytics.local.json
